# Copy to /etc/gravitynas/gravitynas.env and chmod 0640.
# Never commit real secrets to the repository.
GRAVITY_STORAGE_PATH=/var/lib/gravitynas/storage
GRAVITY_DATA_PATH=/var/lib/gravitynas/data
GRAVITY_MASTER_PWD=
NAS_PORT=8000
NAS_MAX_UPLOAD_BYTES=10737418240
# Set to 1 only when remote access has been deliberately configured.
GRAVITY_ALLOW_REMOTE=0
# Optional HTTPS URL to a signed gravitynas-VERSION.tar.gz release.
GRAVITYNAS_UPDATE_URL=
